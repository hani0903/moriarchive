{
    "name": "moriarchive",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev --hostname 127.0.0.1",
        "build": "next build",
        "start": "next start --hostname 127.0.0.1",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src content scripts tests",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "tsx --test tests/*.test.ts",
        "check": "pnpm run format:check && pnpm run lint && pnpm run test && pnpm run typecheck && pnpm run build",
        "clean": "node scripts/clean.mjs",
        "reinstall": "node scripts/clean.mjs --all && pnpm install",
        "post:new": "tsx scripts/new-post.ts",
        "dev:demo": "tsx scripts/dev-demo.ts"
    },
    "dependencies": {
        "gray-matter": "^4.0.3",
        "hast-util-to-string": "^3.0.1",
        "lucide-react": "^1.41.0",
        "mermaid": "^12.0.0",
        "next": "16.3.4",
        "next-mdx-remote": "^6.0.0",
        "next-themes": "^0.4.6",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "rehype-pretty-code": "^0.14.1",
        "rehype-slug": "^6.0.0",
        "remark-gfm": "^4.0.1",
        "shiki": "^4.0.0",
        "unist-util-visit": "^5.0.0",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.0.0",
        "@tailwindcss/typography": "^0.5.20",
        "@types/hast": "^3.0.4",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^24.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "eslint": "^9.39.1",
        "eslint-config-next": "16.3.4",
        "jsdom": "^30.0.1",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.0.0",
        "tsx": "^4.20.0",
        "typescript": "^5.9.3"
    },
    "packageManager": "pnpm@10.15.1",
    "pnpm": {
        "onlyBuiltDependencies": [
            "@tailwindcss/oxide",
            "esbuild",
            "sharp"
        ]
    }
}
